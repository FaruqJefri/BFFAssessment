# ---------------------------------------------------------------------------
# BFF
# ---------------------------------------------------------------------------
PORT=5000

# Shared secret the Next.JS server presents in x-portal-key. It lives only in
# the portal server process - never in a browser bundle, never in a cookie.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_API_KEY=replace-me-with-a-random-32-byte-hex-string

# Browser origins allowed to call this service directly. Leave empty: the portal
# calls it server-side.
CORS_ORIGINS=

# Publish the OpenAPI document at /docs. Turn this off in production.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Google identity verification
# ---------------------------------------------------------------------------
# The OAuth2 client id the portal signs in with. ID tokens are verified against
# Google JWKS with this as the required audience.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# Refuse accounts whose Google email is unverified.
REQUIRE_VERIFIED_EMAIL=true

# Optional allow-list, e.g. zurich.com,zurich.com.my. Empty means any domain.
ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# Core API (BackendAssessment)
# ---------------------------------------------------------------------------
CORE_API_URL=http://127.0.0.1:4000
CORE_API_TIMEOUT_MS=10000

# Must match SERVICE_API_KEY in the BackendAssessment .env
CORE_API_SERVICE_KEY=replace-me-with-the-backend-service-api-key
